# Telegram Bot
BOT_TOKEN=
BOT_USERNAME=

# Администраторы (через запятую, например: 123456789,987654321)
ADMIN_TELEGRAM_IDS=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/YOUR_BOT_USERNAME

# Webhook
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_PATH_SECRET=

# База данных
DATABASE_PATH=./data/bot.sqlite

# Контент
FREE_CHECKLIST_PATH=./assets/free-checklist.pdf

# Курс
COURSE_PRICE_RUB=500
COURSE_TIMEZONE=Europe/Moscow
LESSON_SEND_HOUR=10
LESSON_SEND_MINUTE=0

# Логирование
LOG_LEVEL=info

# Окружение
NODE_ENV=development
