{
  "name": "engbot",
  "version": "1.0.0",
  "description": "Telegram-бот для продажи 30-дневного курса английского языка",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "seed:vocab": "tsx src/scripts/seedVocabulary.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "4.18.3",
    "grammy": "1.26.0",
    "pino": "9.1.0",
    "pino-pretty": "11.0.0",
    "uuid": "9.0.1",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.21",
    "@types/node": "20.12.7",
    "@types/uuid": "9.0.8",
    "tsx": "4.7.3",
    "typescript": "5.4.5",
    "vitest": "1.5.0"
  }
}
